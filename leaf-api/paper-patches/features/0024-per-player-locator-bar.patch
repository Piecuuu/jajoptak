Subject: [PATCH] per-player locator bar


diff --git a/src/main/java/org/bukkit/entity/Player.java b/src/main/java/org/bukkit/entity/Player.java
index 7ca713c737f977446488486095a028d7a8e8353c..76449e35ba7d6a6220e62e4a0980ebbf8551ee38 100644
--- a/src/main/java/org/bukkit/entity/Player.java
+++ b/src/main/java/org/bukkit/entity/Player.java
@@ -4187,4 +4187,20 @@ public interface Player extends HumanEntity, Conversable, OfflinePlayer, PluginM
     @Deprecated(forRemoval = true)
     CompletableFuture<ItemStack> getSkullAsynchronously();
     // Leaf end - KeYi - Player Skull API
+
+    // piecuu start - per-player locator bar
+    /**
+     * Get the state of the per-player locator bar.
+     * This will not work for if the server has the locator bar gamerule enabled.
+     * @return The state of the per-player locator bar
+     */
+    boolean getForceLocatorBar();
+
+    /**
+     * Sets the state of the per-player locator bar.
+     * This will not enable the locator bar globally. Change the gamerule for this.
+     * @param enabled
+     */
+    void setForceLocatorBar(boolean enabled);
+    // piecuu end - per-player locator bar
 }
