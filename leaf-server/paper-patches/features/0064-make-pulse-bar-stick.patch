diff --git a/src/main/java/dev/pulsemc/network/PulseBarTask.java b/src/main/java/dev/pulsemc/network/PulseBarTask.java
new file mode 100644
index 0000000000000000000000000000000000000000..2a9fca8879c942909a1938408e2011e93ea8a358
--- /dev/null
+++ b/src/main/java/dev/pulsemc/network/PulseBarTask.java
@@ -0,0 +1,100 @@
+package dev.pulsemc.network;
+
+import dev.pulsemc.config.ConfigManager;
+import net.kyori.adventure.bossbar.BossBar;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.minimessage.MiniMessage;
+import org.bukkit.entity.Player;
+
+public class PulseBarTask extends org.purpurmc.purpur.task.BossBarTask {
+    private static PulseBarTask instance;
+    private static final MiniMessage mm = MiniMessage.miniMessage();
+
+    private int tick = 0;
+
+    private double efficiency = 0D;
+    private double speed = 0D;
+
+    public double getEfficiency() {
+        double ef = this.efficiency;
+
+        if (ef < 0) ef = 0;
+        if (ef > 1) ef = 1;
+
+        return ef;
+    }
+
+    public double getSpeed() {
+        return this.speed;
+    }
+
+    public static PulseBarTask instance() {
+        if(instance == null) {
+            instance = new PulseBarTask();
+        }
+        return instance;
+    }
+
+    @Override
+    protected BossBar createBossBar() {
+        return BossBar.bossBar(
+            Component.empty(),
+            1.0f,
+            BossBar.Color.GREEN,
+            BossBar.Overlay.NOTCHED_20
+        );
+    }
+
+    @Override
+    public void run() {
+        int interval = Math.max(1, ConfigManager.metricsUpdateInterval * 20);
+        if(++this.tick < interval) {
+            return;
+        }
+        this.tick = 0;
+
+        double logical = Math.max(1, PulseMetrics.ppsLogical);
+        double ef = (logical - PulseMetrics.ppsPhysical) / logical;
+
+        this.efficiency = ef;
+        this.speed = PulseMetrics.networkSpeedKbs;
+
+        super.run();
+    }
+
+    private BossBar.Color getBossBarColor() {
+        BossBar.Color color;
+        if (this.getEfficiency() > 0.75) color = BossBar.Color.GREEN;
+        else if (this.getEfficiency() > 0.40) color = BossBar.Color.YELLOW;
+        else color = BossBar.Color.RED;
+
+        return color;
+    }
+
+    private String getFormattedSpeedString() {
+        String speedStr;
+        if (this.speed > 1024) {
+            speedStr = String.format("%.2f MB/s", this.speed / 1024.0);
+        } else {
+            speedStr = String.format("%.1f KB/s", this.speed);
+        }
+
+        return speedStr;
+    }
+
+    @Override
+    protected void updateBossBar(BossBar bossBar, Player player) {
+        String title = String.format(
+            "<bold><gradient:#FF005D:#FF0048>Pulse</gradient></bold> <dark_gray>| <white>Eff: <color:%s>%d%%</color> <dark_gray>| <white>Vanilla: <aqua>%d p/s <dark_gray>| <white>Out: <aqua>%d p/s</aqua> <gray>(%s)",
+            (this.getEfficiency() > 0.75 ? "#55FF55" : (this.getEfficiency() > 0.4 ? "#FFFF55" : "#FF5555")),
+            (int)(this.getEfficiency() * 100),
+            (int) PulseMetrics.ppsLogical,
+            (int) PulseMetrics.ppsPhysical,
+            getFormattedSpeedString()
+        );
+
+        bossBar.name(mm.deserialize(title));
+        bossBar.progress((float)this.getEfficiency());
+        bossBar.color(this.getBossBarColor());
+    }
+}
