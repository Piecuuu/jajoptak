diff --git a/src/main/java/dev/pulsemc/api/enums/FlushReason.java b/src/main/java/dev/pulsemc/api/enums/FlushReason.java
new file mode 100644
index 0000000000000000000000000000000000000000..786c28c99efb5e591e6054c5ec1ad6d2e82653df
--- /dev/null
+++ b/src/main/java/dev/pulsemc/api/enums/FlushReason.java
@@ -0,0 +1,36 @@
+package dev.pulsemc.api.enums;
+
+/**
+ * Represents the reason why the packet buffer was flushed to the network.
+ */
+public enum FlushReason {
+    /**
+     * The buffer exceeded the maximum byte size.
+     */
+    LIMIT_BYTES,
+
+    /**
+     * The buffer exceeded the maximum packet count.
+     */
+    LIMIT_COUNT,
+
+    /**
+     * Flushed at the end of the server tick.
+     */
+    TICK,
+
+    /**
+     * Flushed because a critical packet (e.g., KeepAlive) or a packet with a listener was sent.
+     */
+    INSTANT,
+
+    /**
+     * Flushed by the interval scheduler (Interval Mode).
+     */
+    INTERVAL,
+
+    /**
+     * Flushed manually via the API or command.
+     */
+    MANUAL
+}
diff --git a/src/main/java/dev/pulsemc/api/events/PulseBufferFlushEvent.java b/src/main/java/dev/pulsemc/api/events/PulseBufferFlushEvent.java
